{% extends "base.html.j2" %}
{% block title %}Sign in · ThreatAtlas Reports{% endblock %}
{% block main %}
<section class="card narrow">
  <h1>Sign in to ThreatAtlas</h1>
  <p class="lead">Use your own personal API token. Reports are built with your access rights: you see exactly the products ThreatAtlas shows you.</p>
  {% if expired %}<p class="alert">ThreatAtlas no longer accepts your token. Sign in again.</p>{% endif %}
  {% if error %}<p class="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/signin" class="stack">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <label>ThreatAtlas address
      <input type="url" name="url" required placeholder="https://threatatlas.example.com" value="{{ form_url }}" autocomplete="url">
    </label>
    <label>API token
      <input type="password" name="token" required placeholder="ta_…" autocomplete="off" spellcheck="false">
    </label>
    <p class="hint">Create one in ThreatAtlas under <strong>Settings → Integrations → API Tokens</strong>. It stays in this app's memory and is never written to disk.</p>
    <label class="check"><input type="checkbox" name="remember" value="1"> Remember it in this computer's credential store (Windows Credential Manager / Secret Service). Signing out forgets it again.</label>
    <button type="submit" class="primary">Sign in</button>
  </form>
</section>
{% endblock %}
