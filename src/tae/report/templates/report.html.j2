{#- Main report template. Override any file in this directory by putting a file with
    the same name in the definition's `template:` directory. Colours, fonts, page size,
    header/footer and wording come from the report theme (docs/theming.md). -#}
{% import "macros.html.j2" as m %}
<!doctype html>
<html lang="{{ definition.language }}">
<head>
<meta charset="utf-8">
<title>{{ title }} — {{ product.name }}</title>
<meta name="generator" content="ThreatAtlasExporter {{ tool_version }}">
<style>
{{ theme_css }}
</style>
<link rel="stylesheet" href="styles/default.css">
{% if extra_css %}<style>
{{ extra_css }}
</style>{% endif %}
</head>
<body>
{% if theme.watermark %}<div class="watermark">{{ theme.watermark.text }}</div>{% endif %}
{% for s in sections %}
<section id="{{ s.anchor }}" class="section section-{{ s.type }}{% if s.page_break %} page-break{% endif %}{% if s.type == 'cover' %} cover-layout-{{ theme.cover.layout }}{% endif %}">
{% if s.type != "cover" and s.title %}
  <h1>{% if s.number %}<span class="num">{{ s.number }}</span>{% endif %}{{ s.title }}</h1>
{% endif %}
{% include "sections/" ~ s.type ~ ".html.j2" %}
</section>
{% endfor %}
</body>
</html>
