<div class="cover-band logo-{{ theme.cover.logo_position }}">
  {% if s.data.logo %}<img class="cover-logo" src="{{ s.data.logo }}" alt="">{% endif %}
  {% if branding.organisation %}<div class="cover-org">{{ branding.organisation }}</div>{% endif %}
</div>
<div class="cover-body">
  {% if branding.classification %}<div class="cover-classification">{{ branding.classification }}</div>{% endif %}
  <h1 class="cover-title">{{ s.title or title }}</h1>
  {% if subtitle %}<div class="cover-subtitle">{{ subtitle }}</div>{% endif %}
  {% if banner %}
  <div class="validation-banner">
    Validation failed: {{ validation.counts()["error"] }} error(s), {{ validation.counts()["warning"] }} warning(s).
    See the validation findings section before relying on this report.
  </div>
  {% endif %}
  {% if s.data.facts %}
  <table class="facts cover-facts">
    {% for label, value in s.data.facts %}<tr><th>{{ label }}</th><td>{{ value }}</td></tr>{% endfor %}
  </table>
  {% endif %}
</div>
{% if theme.cover.show_generated_by %}
<div class="cover-foot">
  {{ t("text.generated_by") }} ThreatAtlasExporter {{ tool_version }} · snapshot {{ snapshot_hash }}{% if meta.pulled_by %} · pulled by {{ meta.pulled_by }}{% endif %}
</div>
{% endif %}
